# ── LLM (Phase 0: switched from Groq to Gemini) ──────────────────────────────
# Get a key at https://aistudio.google.com/apikey and paste it below.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
MODEL=gemini-3.6-flash
FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Optional: minimal | low | medium | high (leave empty for the model default)
GEMINI_THINKING_LEVEL=

# To go back to Groq instead:
# LLM_PROVIDER=groq
# API_KEY=your_groq_key
# MODEL=llama-3.3-70b-versatile
# FALLBACK_MODELS=llama-3.1-8b-instant

# ── Retrieval (all optional; defaults live in config/settings.py) ────────────
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RETRIEVAL_MODE=hybrid
# USE_RERANKER=true
# MAX_CHUNKS_PER_SOURCE=3
# MAX_CONTEXT_CHARS=6000
# MIN_RERANK_SCORE=0.30
